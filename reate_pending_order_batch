-- ============================================================
-- CREDI MARKETPLACE
-- RPC: create_pending_order_batch
--
-- Objetivo:
--   Crear una orden pendiente con múltiples productos
--   de forma completamente transaccional.
--
-- Garantías:
--   - Usuario autenticado
--   - Productos bloqueados FOR UPDATE
--   - Precio exclusivamente desde PostgreSQL
--   - Validación de producto activo
--   - Validación de stock
--   - Validación de cantidades
--   - Validación de afiliado
--   - Cálculo server-side
--   - Inserción de orders
--   - Inserción de order_items
--   - Descuento/reserva atómica del inventario
--   - Todo o nada
-- ============================================================

create or replace function public.create_pending_order_batch(
  p_buyer_id uuid,
  p_items jsonb,
  p_affiliate_ref text default null,
  p_region text default 'GLOBAL'
)
returns jsonb
language plpgsql
security invoker
set search_path = public
as $$
declare
  v_order_id uuid;
  v_total numeric(18,2) := 0;
  v_item_count integer := 0;
  v_affiliate_id uuid := null;
  v_item jsonb;
  v_product_id uuid;
  v_quantity integer;
  v_price numeric(18,2);
  v_stock integer;
  v_title text;
  v_is_active boolean;
  v_subtotal numeric(18,2);
begin

  ----------------------------------------------------------------
  -- 1. Validación del comprador
  ----------------------------------------------------------------

  if p_buyer_id is null then
    raise exception using
      errcode = 'P0001',
      message = 'buyer_required';
  end if;

  /*
   * SECURITY INVOKER:
   *
   * La función utiliza los permisos/RLS del usuario que ejecuta
   * la RPC.
   *
   * Además comprobamos que el UUID corresponde a auth.uid().
   */

  if auth.uid() is null then
    raise exception using
      errcode = 'P0001',
      message = 'unauthenticated';
  end if;

  if auth.uid() <> p_buyer_id then
    raise exception using
      errcode = 'P0001',
      message = 'buyer_mismatch';
  end if;


  ----------------------------------------------------------------
  -- 2. Validación básica del payload
  ----------------------------------------------------------------

  if p_items is null
     or jsonb_typeof(p_items) <> 'array'
     or jsonb_array_length(p_items) = 0 then

    raise exception using
      errcode = 'P0001',
      message = 'empty_order';
  end if;

  /*
   * Límite defensivo.
   *
   * Evita que un cliente intente enviar miles de líneas.
   */

  if jsonb_array_length(p_items) > 50 then
    raise exception using
      errcode = 'P0001',
      message = 'too_many_items';
  end if;


  ----------------------------------------------------------------
  -- 3. Validación del afiliado
  ----------------------------------------------------------------
  --
  -- IMPORTANTE:
  --
  -- Sustituir "affiliates" por el nombre real de tu tabla si
  -- actualmente utilizas otra estructura.
  --
  -- Nunca se debe aceptar una comisión simplemente porque el
  -- cliente envió un porcentaje.
  ----------------------------------------------------------------

  if p_affiliate_ref is not null
     and length(trim(p_affiliate_ref)) > 0 then

    select a.id
      into v_affiliate_id
      from public.affiliates a
     where (
       a.id::text = trim(p_affiliate_ref)
       or a.referral_code = trim(p_affiliate_ref)
       or a.slug = trim(p_affiliate_ref)
     )
       and coalesce(a.is_active, true) = true
     limit 1;

    if v_affiliate_id is null then
      raise exception using
        errcode = 'P0001',
        message = 'invalid_affiliate';
    end if;
  end if;


  ----------------------------------------------------------------
  -- 4. Validar todas las líneas ANTES de modificar inventario
  ----------------------------------------------------------------
  --
  -- Cada producto se bloquea con FOR UPDATE.
  --
  -- Esto es esencial para impedir:
  --
  -- Usuario A: compra 8
  -- Usuario B: compra 8
  -- Stock: 10
  --
  -- Sin bloqueo ambos podrían leer stock=10.
  --
  -- Con FOR UPDATE una transacción espera a la otra.
  ----------------------------------------------------------------

  for v_item in
    select value
    from jsonb_array_elements(p_items)
  loop

    v_product_id :=
      case
        when v_item->>'product_id' is not null
        then (v_item->>'product_id')::uuid
        else null
      end;

    v_quantity :=
      case
        when v_item->>'quantity' ~ '^[0-9]+$'
        then (v_item->>'quantity')::integer
        else null
      end;


    if v_product_id is null then
      raise exception using
        errcode = 'P0001',
        message = 'invalid_product_id';
    end if;


    if v_quantity is null
       or v_quantity < 1
       or v_quantity > 100 then

      raise exception using
        errcode = 'P0001',
        message = 'invalid_quantity';
    end if;


    ----------------------------------------------------------------
    -- Precio, stock y estado exclusivamente desde PostgreSQL
    ----------------------------------------------------------------

    select
      p.price,
      p.stock,
      p.title,
      p.is_active
    into
      v_price,
      v_stock,
      v_title,
      v_is_active
    from public.products p
    where p.id = v_product_id
    for update;


    if not found then
      raise exception using
        errcode = 'P0001',
        message = 'product_not_found';
    end if;


    if coalesce(v_is_active, false) = false then
      raise exception using
        errcode = 'P0001',
        message = 'product_inactive';
    end if;


    if v_price is null
       or v_price < 0 then

      raise exception using
        errcode = 'P0001',
        message = 'invalid_product_price';
    end if;


    if v_stock is null
       or v_stock < v_quantity then

      raise exception using
        errcode = 'P0001',
        message = 'insufficient_stock';
    end if;


    ----------------------------------------------------------------
    -- Cálculo server-side
    ----------------------------------------------------------------

    v_subtotal :=
      round(v_price * v_quantity, 2);

    v_total :=
      round(v_total + v_subtotal, 2);

    v_item_count :=
      v_item_count + v_quantity;

  end loop;


  ----------------------------------------------------------------
  -- 5. Protección contra totales imposibles
  ----------------------------------------------------------------

  if v_total <= 0 then
    raise exception using
      errcode = 'P0001',
      message = 'invalid_order_total';
  end if;


  ----------------------------------------------------------------
  -- 6. Crear la orden
  ----------------------------------------------------------------

  insert into public.orders (
    customer_id,
    total_amount,
    region,
    status,
    affiliate_id,
    created_at,
    updated_at
  )
  values (
    p_buyer_id,
    v_total,
    coalesce(nullif(trim(p_region), ''), 'GLOBAL'),
    'pending',
    v_affiliate_id,
    now(),
    now()
  )
  returning id into v_order_id;


  ----------------------------------------------------------------
  -- 7. Crear líneas de orden
  ----------------------------------------------------------------

  for v_item in
    select value
    from jsonb_array_elements(p_items)
  loop

    v_product_id :=
      (v_item->>'product_id')::uuid;

    v_quantity :=
      (v_item->>'quantity')::integer;


    /*
     * Volvemos a leer el producto dentro de la misma transacción.
     *
     * El bloqueo adquirido anteriormente permanece vigente.
     */

    select
      p.price,
      p.stock,
      p.title
    into
      v_price,
      v_stock,
      v_title
    from public.products p
    where p.id = v_product_id
    for update;


    v_subtotal :=
      round(v_price * v_quantity, 2);


    insert into public.order_items (
      order_id,
      product_id,
      quantity,
      unit_price,
      subtotal,
      product_title
    )
    values (
      v_order_id,
      v_product_id,
      v_quantity,
      v_price,
      v_subtotal,
      v_title
    );


    ----------------------------------------------------------------
    -- 8. Descuento/reserva atómica del inventario
    ----------------------------------------------------------------

    update public.products
       set stock = stock - v_quantity,
           updated_at = now()
     where id = v_product_id
       and stock >= v_quantity;


    /*
     * Si otra operación modificó el inventario entre la lectura
     * y este punto, la actualización no afecta ninguna fila.
     */

    if not found then
      raise exception using
        errcode = 'P0001',
        message = 'stock_changed';
    end if;

  end loop;


  ----------------------------------------------------------------
  -- 9. Resultado público de la RPC
  ----------------------------------------------------------------

  return jsonb_build_object(
    'success', true,
    'order_id', v_order_id,
    'status', 'pending',
    'total_amount', v_total,
    'currency', 'USD',
    'item_count', v_item_count
  );


exception
  when invalid_text_representation then

    raise exception using
      errcode = 'P0001',
      message = 'invalid_payload';

end;
$$;