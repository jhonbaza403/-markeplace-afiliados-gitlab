{
  "name": "marketplace-afiliados",
  "version": "1.0.0",
  "private": true,
  "type": "module",

  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },

  "packageManager": "pnpm@10.15.0",

  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "type-check": "tsc --noEmit",

    "check": "pnpm lint && pnpm type-check",

    "clean": "node -e \"for (const p of ['.next','node_modules']) fs.rmSync(p,{recursive:true,force:true})\"",

    "clean:build": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\""
  },

  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@google/generative-ai": "^0.24.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.9",

    "lucide-react": "^0.468.0",

    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },

  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",

    "babel-plugin-react-compiler": "^19.0.0",

    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",

    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",

    "typescript": "^5.7.0"
  }
}