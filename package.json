{
  "name": "credi-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Credi Marketplace - Plataforma global de comercio, servicios, empleo y publicidad inteligente",
  "keywords": [
    "credi-marketplace",
    "marketplace",
    "ecommerce",
    "services",
    "jobs",
    "advertising",
    "ai",
    "nextjs",
    "cloudflare"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.52.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "latest",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=20.9.0"
  }
