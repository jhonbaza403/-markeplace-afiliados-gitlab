# =========================================================
# CREDI MARKETPLACE - ENVIRONMENT VARIABLES
# =========================================================

# --- Supabase Configuration (Público) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Supabase Configuration (Privado - Solo Servidor) ---
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Database Connection (PostgreSQL Direct / Pooler) ---
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?schema=public"
# Opcional: Si usas Supabase Transaction Pooler en Server Actions
DIRECT_URL="postgresql://postgres:your_password@db.your-project.supabase.co:6543/postgres?schema=public&pgbouncer=true"

# --- Gemini AI (Fase 7) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- App Settings & Meta ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Credi Marketplace"
NEXT_PUBLIC_ENV=development # development | staging | production

# --- Internacionalización, Regiones y Divisas ---
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_COUNTRY=VE

# --- Cache, Performance & React 19 Compiler ---
# Permite revalidar cache en ISR / Server Actions dinámicos
REVALIDATE_SECRET=your_custom_random_revalidate_secret_here

# --- Vercel & Cloudflare Edge Headers ---
# Asegura que las imágenes y assets carguen correctamente tras el proxy de Cloudflare
NEXT_PUBLIC_CDN_URL=https://tu-dominio.com